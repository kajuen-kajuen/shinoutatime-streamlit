{
  "permissions": {
    "allow": [
      "Bash(sh tools/check-rules.sh)",
      "Bash(docker compose ps)",
      "Bash(docker compose up -d)",
      "Bash(docker compose logs*)",
      "Bash(docker compose exec shinouta-time pytest*)",
      "Read(**)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout main)",
      "Bash(git checkout develop)",
      "Bash(git switch main)",
      "Bash(git switch develop)",
      "Read(./.env)",
      "Read(./.streamlit/secrets.toml)"
    ],
    "ask": [
      "Bash(git commit*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -Eq 'git( -C [^ ]+)? commit' || exit 0; sh \"$CLAUDE_PROJECT_DIR/tools/check-rules.sh\" 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
