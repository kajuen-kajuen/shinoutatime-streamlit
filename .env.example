# しのうたタイム - 環境変数設定例
# このファイルを .env にコピーして使用してください(.env は Git に入れない。値をコミットしない)
# docker-compose.yml がコンテナに渡すのは、ログと取り込みの変数です(SETUP.md の「環境変数」)

# ========================================
# ログ
# ========================================
# ログレベル: DEBUG, INFO, WARNING, ERROR
SHINOUTA_LOG_LEVEL=INFO

# ファイルへのログ出力を有効化: true, false(10MB で回し、5世代残す)
SHINOUTA_ENABLE_FILE_LOGGING=false

# ログファイルのパス
SHINOUTA_LOG_FILE=logs/shinouta.log

# ========================================
# データの取り込み(data/v2/。docs/prompts/update-data.md)
# ========================================
# YouTube Data API v3 のキー(Google Cloud で作成。API の制限で YouTube Data API v3 だけに絞る)
# YOUTUBE_API_KEY=your_youtube_api_key
# 複数のキーを使うときは、カンマ区切りで足す(YOUTUBE_API_KEY → この並びの順に使い、上限に達したら次のキーに切り替える)
# YOUTUBE_API_KEYS=your_second_key,your_third_key

# 職人さんの表示名(カンマ区切り)。指定すると、その人のセットリストのコメントを優先する
# SHINOUTA_TRUSTED_COMMENTERS=@example1,@example2

# ========================================
# 画面(既定のままで動く。変えるときは docker-compose.yml の environment にも足す)
# ========================================
# 画面が読むデータのディレクトリ
# SHINOUTA_V2_DATA_DIR=data/v2

# 表示の件数
# SHINOUTA_INITIAL_DISPLAY_LIMIT=25
# SHINOUTA_DISPLAY_INCREMENT=25

# ========================================
# X の埋め込みコードの取得(python -m src.cli.twitter_embed_cli のログ)
# ========================================
# TWITTER_EMBED_LOG_LEVEL=INFO
# TWITTER_EMBED_LOG_FILE=logs/twitter_embed.log
