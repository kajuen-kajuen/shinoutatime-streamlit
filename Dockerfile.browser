# ブラウザの確認(tests/browser/)を流すイメージ。アプリのイメージ(Dockerfile)とは分ける
# 使い方: docker compose --profile browser run --rm browser pytest tests/browser --runbrowser
FROM python:3.14.8-slim-trixie

WORKDIR /app

COPY requirements-browser.txt ./
RUN pip install --no-cache-dir -r requirements-browser.txt \
    && python -m playwright install --with-deps chromium

CMD ["pytest", "tests/browser", "--runbrowser"]
