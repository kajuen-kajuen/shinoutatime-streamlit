                f.write('米津玄師\tよねづけんし\n')
            repo = ArtistSortMappingRepository(str(file_path))
            mappings = repo.load_mappings()
            assert len(mappings) == 2
            assert mappings['Vaundy'] == 'Vaundy'
            assert mappings['米津玄師'] == 'よねづけんし'
